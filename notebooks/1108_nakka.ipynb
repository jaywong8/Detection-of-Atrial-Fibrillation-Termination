from __future__ import annotations

import importlib.util
import os
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent
REQUIRED_MODULES = ("numpy", "wfdb", "sklearn")
missing_modules = [name for name in REQUIRED_MODULES if importlib.util.find_spec(name) is None]
if missing_modules:
    project_python = ROOT / "physionet-main" / ".venv" / "bin" / "python"
    if project_python.is_file() and project_python.absolute() != Path(sys.executable).absolute():
        print(f"Restarting with project Python because these packages are missing: {', '.join(missing_modules)}")
        os.execv(str(project_python), [str(project_python), str(Path(__file__).resolve()), *sys.argv[1:]])
    raise SystemExit(
        f"Missing packages: {', '.join(missing_modules)}. Install them with "
        "python -m pip install numpy wfdb scikit-learn, or run with the project .venv interpreter."
    )

import numpy as np
import wfdb
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import balanced_accuracy_score, classification_report, confusion_matrix
from sklearn.model_selection import StratifiedGroupKFold
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler


DATA_DIR = ROOT / "data" / "mitdb"
BEFORE_SECONDS = 0.25
AFTER_SECONDS = 0.45
SYMBOL_TO_CLASS = {
    "N": "Normal",
    "L": "Normal",
    "R": "Normal",
    "e": "Normal",
    "j": "Normal",
    "A": "PAC",
    "V": "PVC",
}
CLASS_NAMES = ["Normal", "PAC", "PVC"]


def load_beats() -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """Download MIT-BIH and return fixed-length beats, labels, and record groups."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    records = wfdb.get_record_list("mitdb")
    wfdb.dl_database("mitdb", dl_dir=str(DATA_DIR), records=records)

    windows: list[np.ndarray] = []
    labels: list[str] = []
    groups: list[str] = []

    for record_name in records:
        record_path = DATA_DIR / record_name
        record = wfdb.rdrecord(str(record_path), channels=[0])
        annotation = wfdb.rdann(str(record_path), "atr")
        signal = record.p_signal[:, 0]
        left = round(BEFORE_SECONDS * record.fs)
        right = round(AFTER_SECONDS * record.fs)
        beat_samples = np.asarray(annotation.sample)
        rr_intervals = np.diff(beat_samples) / record.fs

        for beat_index, (sample, symbol) in enumerate(zip(beat_samples, annotation.symbol)):
            beat_class = SYMBOL_TO_CLASS.get(symbol)
            start = sample - left
            stop = sample + right
            if beat_class is None or beat_index == 0 or start < 0 or stop > len(signal):
                continue
            previous_rr = rr_intervals[beat_index - 1]
            local_rr = rr_intervals[max(0, beat_index - 6):beat_index]
            relative_rr = previous_rr / np.median(local_rr)
            windows.append(np.concatenate((signal[start:stop], [previous_rr, relative_rr])))
            labels.append(beat_class)
            groups.append(record_name)

    if not windows:
        raise ValueError("No Normal, PAC, or PVC beats were loaded from MIT-BIH")

    return np.asarray(windows, dtype=np.float32), np.asarray(labels), np.asarray(groups)


def record_holdout(
    features: np.ndarray, labels: np.ndarray, groups: np.ndarray
) -> tuple[np.ndarray, np.ndarray]:
    """Choose a stratified fold whose held-out records contain every class."""
    splitter = StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=42)
    for train_indices, test_indices in splitter.split(features, labels, groups):
        if set(labels[test_indices]) == set(CLASS_NAMES):
            return train_indices, test_indices
    raise ValueError("Could not create a record-level test fold containing all three classes")


def main() -> None:
    features, labels, groups = load_beats()
    train_indices, test_indices = record_holdout(features, labels, groups)

    model = make_pipeline(
        StandardScaler(),
        LogisticRegression(class_weight="balanced", max_iter=1500),
    )
    model.fit(features[train_indices], labels[train_indices])
    predictions = model.predict(features[test_indices])

    test_records = sorted(set(groups[test_indices]))
    print("Dataset: MIT-BIH Arrhythmia Database (lead 0, 360 Hz)")
    print(f"Beat window: {BEFORE_SECONDS:.2f}s before to {AFTER_SECONDS:.2f}s after annotation")
    print(f"Beats: {len(features):,} | records: {len(set(groups))}")
    print(
        f"Train: {len(train_indices):,} beats | test: {len(test_indices):,} beats "
        f"from {len(test_records)} held-out records"
    )
    print(f"Held-out records: {', '.join(test_records)}")
    print(f"Balanced accuracy: {balanced_accuracy_score(labels[test_indices], predictions):.3f}")
    print("\nHeld-out classification report:")
    print(classification_report(labels[test_indices], predictions, labels=CLASS_NAMES, zero_division=0))
    print("Confusion matrix [rows=true, columns=predicted]:")
    print(confusion_matrix(labels[test_indices], predictions, labels=CLASS_NAMES))


if __name__ == "__main__":
    main()
